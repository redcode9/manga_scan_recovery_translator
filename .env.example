# Copia questo file in .env e popola le chiavi che ti servono.
# Per il prossimo E2E reale useremo OpenAI: imposta OPENAI_API_KEY e usa --model gpt.
# In generale msrt richiede ALMENO la chiave corrispondente al --model che usi.

# ---------- LLM provider keys ----------

# Anthropic (Claude). Default per --model sonnet|opus.
# https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenAI (GPT). Percorso E2E consigliato: --model gpt -> gpt-5.5.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google Gemini. Per --model gemini-pro|gemini-flash.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ---------- LiteLLM proxy ----------

# Porta locale del proxy LiteLLM (default 4000).
LITELLM_PORT=4000

# ---------- manga-image-translator (MITR) ----------

# Come invocare il motore esterno. Esempi:
#   - subprocess CLI:  MITR_BIN_PATH="/Users/you/tools/mitr/.venv/bin/python -m manga_translator"
#   - HTTP server:     MITR_BIN_PATH=http://localhost:8001
# msrt doctor verifica che il valore funzioni.
MITR_BIN_PATH=
